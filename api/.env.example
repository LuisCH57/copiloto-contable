# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# Conexión a PostgreSQL (por ejemplo, Neon). Termina en ?sslmode=verify-full
DATABASE_URL=postgresql://usuario:contraseña@servidor/base?sslmode=verify-full

# Clave para firmar los tokens. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# Sitios que pueden usar la API desde el navegador, separados por comas
CORS_ORIGIN=http://localhost:5173
